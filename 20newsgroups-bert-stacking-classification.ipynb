    {
      "cell_type": "markdown",
      "source": [
        "**Extracting layer from pretrained bert model and adding a layer with softmax function to classify 20 classes of news.**"
      ],
      "metadata": {
        "id": "-RRJwpSlCRV6"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "!pip install tensorflow-addons\n",
        "import tensorflow.compat.v1 as tf\n",
        "from tensorflow.keras.initializers import GlorotNormal\n",
        "from tensorflow.keras.optimizers import AdamW\n",
        "\n",
        "optimizer = AdamW(learning_rate=LR)\n",
        "\n",
        "\n",
        "tf.enable_eager_execution()\n",
        "\n",
        "\n",
        "inputs = model.inputs[:2]\n",
        "dense = model.get_layer('NSP-Dense').output\n",
        "outputs = tensorflow.keras.layers.Dense(units=20, activation='softmax',  kernel_initializer=GlorotNormal(seed=42))(dense)\n",
        "\n",
        "model = tensorflow.keras.models.Model(inputs, outputs)\n",
        "model.compile(\n",
        "  optimizer=optimizer,\n",
        "  loss='sparse_categorical_crossentropy',                             #produces a one-hot array containing the probable match for each category\n",
        "  metrics=['sparse_categorical_accuracy'],                            #produces a category index of the most likely matching category\n",
        ")"
      ],
      "metadata": {
        "id": "3MoAOA-NCRV6",
        "execution": {
