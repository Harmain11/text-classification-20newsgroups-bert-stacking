      "source": [
        "import os\n",
        "\n",
        "datapath = \".\".join(dataset.split(\".\")[:-2])                        #plitting the dataset variable into a list of substrings and to select all the elements except the last two\n",
        "txtfiles = os.listdir(datapath)                                     #using to get the list of all files in a specific directory and then using this list for further processing\n",
